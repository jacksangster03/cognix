# ─── v0.1: No environment variables required ─────────────────────────────────
# The v0.1 app is fully local-first. No API keys needed.

# ─── v0.1.1: AI brief layer (provider-agnostic) ───────────────────────────────
# LLM_PROVIDER controls which provider generates the daily brief.
# Valid values: deterministic (default), anthropic, openai, openrouter, ollama
# If LLM_PROVIDER is missing or the required key is absent, the app falls back
# to the deterministic provider automatically.
#
# LLM_PROVIDER=deterministic
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5        # default if omitted

# ─── v0.2: Supabase (add when migrating off localStorage) ────────────────────
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-side only, never in client

# ─── v0.3: Additional LLM providers ──────────────────────────────────────────
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o                      # default if omitted
#
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=anthropic/claude-sonnet-4-5
#
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# ─── v0.4: WHOOP OAuth ────────────────────────────────────────────────────────
# WHOOP_CLIENT_ID=your-whoop-client-id
# WHOOP_CLIENT_SECRET=your-whoop-client-secret
# WHOOP_REDIRECT_URI=https://yourcognix.app/api/auth/whoop/callback

# ─── v0.5: Calendar and weather ──────────────────────────────────────────────
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# OPENWEATHERMAP_API_KEY=your-owm-key

# ─── v0.6: Strava ─────────────────────────────────────────────────────────────
# STRAVA_CLIENT_ID=your-strava-client-id
# STRAVA_CLIENT_SECRET=your-strava-client-secret

# ─── v0.7: Spotify ────────────────────────────────────────────────────────────
# SPOTIFY_CLIENT_ID=your-spotify-client-id
# SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# ─── App config ───────────────────────────────────────────────────────────────
# NEXT_PUBLIC_APP_URL=https://yourcognix.app
